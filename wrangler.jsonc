
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-access-oauth",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
 "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "130e59c7ba904bc788bd24103793b5a2"
    },
    {
      "binding": "OURA_KV",
      "id": "688565d6b62b41d485798d0524de5d8d"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    "required": [
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY",
      "OURA_CLIENT_ID",
      "OURA_CLIENT_SECRET"
    ]
  }
}
